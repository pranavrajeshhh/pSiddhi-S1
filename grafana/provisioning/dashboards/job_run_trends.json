{
  "title": "Job Run Trends",
  "uid": "etl-job-trends",
  "tags": ["etl", "s1-d-03"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Job Duration Over Time (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "etl_job_duration_seconds",
          "legendFormat": "{{pipeline_name}} / {{stage}}",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 2,
      "title": "Rows Ingested Per Stage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "etl_rows_ingested_total",
          "legendFormat": "{{pipeline_name}} / {{stage}}",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}}
      }
    },
    {
      "id": 3,
      "title": "Data Volume Processed (MB)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "etl_data_volume_mb",
          "legendFormat": "{{pipeline_name}} / {{stage}}",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "decmbytes", "color": {"mode": "palette-classic"}}
      }
    },
    {
      "id": 4,
      "title": "Rows Output Per Stage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "etl_rows_output_total",
          "legendFormat": "{{pipeline_name}} / {{stage}}",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}}
      }
    },
    {
      "id": 5,
      "title": "Processing Time Per Stage (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "etl_processing_time_seconds",
          "legendFormat": "{{pipeline_name}} / {{stage}}",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "color": {"mode": "palette-classic"}}
      }
    }
  ]
}
